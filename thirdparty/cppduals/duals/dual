// ===================================================================
// dual<T,N> class
// ===================================================================

namespace duals {

template<class T, int N>
class dual
{
public:
  typedef T value_type;
  static constexpr int num_vars = N;

private:
  value_type _real;
  partials<T, N> _dual;

public:

  /// Construct from optional real and dual parts.
  constexpr
  dual(const value_type re = value_type(), const partials<T,N> du = partials<T,N>())
    : _real(re), _dual(du) {}

  /// Copy construct from a dual of equal depth and same N.
  template<class X, CPPDUALS_ONLY_SAME_DEPTH_AS_T(T,X),
           CPPDUALS_ENABLE_IF(!is_complex<X>::value)>
  dual(const dual<X,N> & x)
    : _real(x.rpart()), _dual(x.dparts()) {}

  /// Cast to a complex<dual<>> with real part equal to *this.
  operator std::complex<dual<T,N>>() { return std::complex<dual<T,N>>(*this, T(0)); }

  /// Explicit cast to an arithmetic type retains the rpart()
  template <class X,
            CPPDUALS_ENABLE_IF(std::is_arithmetic<X>::value && !is_dual<X>::value)>
  explicit operator X() const { return X(_real); }

  /// Get the real part.
  T rpart() const { return _real; }

  /// Get the i-th dual part, i defaults to 0.
  T dpart(int i = 0) const { CPPDUALS_ASSERT_PARTIAL(i); return _dual[i]; }
  T dpart(int i = 0) { CPPDUALS_ASSERT_PARTIAL(i); return _dual[i]; }

  /// A dual part is written through set_dpart(), never through dpart():
  /// dpart(x) reads partial x, and an overload taking a value could not be
  /// told from it -- dpart(4) would pick whichever of the two the argument
  /// type happened to match.  Deleted, so the old spelling does not quietly
  /// become an index.
  template<class U, std::enable_if_t<std::is_floating_point<U>::value, int> = 0>
  void dpart(U) = delete;

  /// Set the real part.
  void set_rpart(value_type re) { _real = re; }

  /// Set the i-th dual part, i defaults to 0.
  void set_dpart(value_type du, int i = 0) { CPPDUALS_ASSERT_PARTIAL(i); _dual[i] = du; }

  /// Get all dual parts (bulk access for math functions).
  const partials<T,N>& dparts() const { return _dual; }
  partials<T,N>& dparts() { return _dual; }

  /// Create a seeded input variable.
  static dual variable(T value, int i) {
    return dual(value, partials<T,N>::unit(i));
  }

  /// Unary negation
  dual operator-() const { return dual(-_real, -_dual); }

  /// Unary nothing
  dual operator+() const { return *this; }

  /// Assignment of value_type assigns the real part and zeros the dual part.
  dual & operator=(const T & x) { _real = x; _dual = partials<T,N>(); return *this; }

  /// Add a relatively-scalar to this dual.
  dual & operator+=(const T & x) { _real += x; return *this; }

  /// Subtract a relatively-scalar from this dual.
  dual & operator-=(const T & x) { _real -= x; return *this; }

  /// Multiply a relatively-scalar with this dual.
  dual & operator*=(const T & x) { _real *= x; _dual *= x; return *this; }

  /// Divide this dual by relatively-scalar.
  dual & operator/=(const T & x) { _real /= x; _dual /= x; return *this; }

  /// Assignment from another dual of same depth and same N.
  template<class X, CPPDUALS_ONLY_SAME_DEPTH_AS_T(T,X)>
  dual & operator=(const dual<X,N> & x) { _real = x.rpart(); _dual = x.dparts(); return *this; }

  /// Add a dual of the same depth.
  template<class X, CPPDUALS_ONLY_SAME_DEPTH_AS_T(T,X)>
  dual & operator+=(const dual<X,N> & x) { _real += x.rpart(); _dual += x.dparts(); return *this; }

  /// Subtract a dual of the same depth.
  template<class X, CPPDUALS_ONLY_SAME_DEPTH_AS_T(T,X)>
  dual & operator-=(const dual<X,N> & x) { _real -= x.rpart(); _dual -= x.dparts(); return *this; }

  /// Multiply this dual with another dual.
  template<class X, CPPDUALS_ONLY_SAME_DEPTH_AS_T(T,X)>
  dual & operator*=(const dual<X,N> & x) {
    // elementwise, so each partial contracts to one fma like the scalar form
    for (int i = 0; i < N; i++)
      _dual[i] = _real * x.dparts()[i] + _dual[i] * x.rpart();
    _real = _real * x.rpart();
    return *this;
  }

  /// Divide this dual by another dual.
  template<class X, CPPDUALS_ONLY_SAME_DEPTH_AS_T(T,X)>
  dual & operator/=(const dual<X,N> & x) {
    _dual = (_dual * x.rpart() - _real * x.dparts()) / (x.rpart() * x.rpart());
    _real = _real / x.rpart();
    return *this;
  }
};

// ===================================================================
// Free function accessors
// ===================================================================

template <class T, int N> T rpart(const dual<T,N> & x) { return x.rpart(); }
template <class T, int N> T dpart(const dual<T,N> & x, int i = 0) { return x.dpart(i); }

/// R-part of complex<dual<T,N>> is non-dual complex<T> (not to be confused with real())
template <class T, int N> std::complex<T> rpart(const std::complex<dual<T,N>> & x)
{ return std::complex<T>(x.real().rpart(), x.imag().rpart()); }

/// Dual part of complex<dual<T,N>> — returns complex of the i-th partial
template <class T, int N> std::complex<T> dpart(const std::complex<dual<T,N>> & x, int i = 0)
{ return std::complex<T>(x.real().dpart(i), x.imag().dpart(i)); }

/// Get a non-dual's real part.
template <class T,
          CPPDUALS_ENABLE_IF((std::is_arithmetic<T>::value &&
                              !std::is_compound<T>::value) || is_complex<T>::value)>
T rpart(const T & x) { return x; }

/// Get a non-dual's dual part := zero.
template <class T,
