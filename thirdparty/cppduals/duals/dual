namespace duals {

/**
\file       dual
\brief      `dual<T,N>` arithmetic and forward-mode automatic differentiation.

\mainpage   cppduals

\section intro Overview

cppduals is a standalone, dependency-free, header-only C++17 template
library for [dual number](https://en.wikipedia.org/wiki/Dual_number)
arithmetic and forward-mode automatic differentiation.  It requires
only a standard-conforming C++ compiler — no external dependencies.

A dual number has the form \f$ a + b\epsilon \f$ where \f$ \epsilon \ne 0 \f$
and \f$ \epsilon^2 = 0 \f$.  Evaluating any differentiable function \f$ f \f$
at a dual argument \f$ x + \epsilon \f$ yields \f$ f(x) + f'(x)\epsilon \f$
— the exact derivative, with no finite-difference approximation.

\section features Features

- **Dependency-free** — only standard library headers; just copy
  the `duals/` directory into your project.
- **Eigen integration** — optional `#include <duals/dual_eigen>` for
  SIMD-vectorized matrix operations with dual-valued elements.
- **Recursive nesting** — `dual<dual<T>>` gives second derivatives;
  nest further for higher orders.
- **Complex composition** — `std::complex<dual<T>>` differentiates
  complex-valued functions.
- **Full math library** — overloads for all standard transcendental,
  hyperbolic, and special functions (exp, log, pow, sin, cos, erf, tgamma, …).
- **Literal syntax** — `1.0 + 2.0_e` constructs `dual<double>(1, 2)`.
- **fmt support** — optional formatters via `#define CPPDUALS_LIBFMT`.

\section example Quick Example


```cpp
#include <duals/dual>
using namespace duals::literals;

template <class T>
T f(T x) { return x * sin(x); }

int main() {
  auto result = f(2.0 + 1.0_e);
  // rpart = f(2)  = 2*sin(2) = 1.8186
  // dpart = f'(2) = sin(2) + 2*cos(2) = 0.0770
  std::cout << result << "\n";  // (1.8186+0.077004_e)
}
```

\section math How It Works

The Taylor expansion of \f$ f(a + b\epsilon) \f$ truncates at first order:

\f[
f(a + b\epsilon) = f(a) + f'(a)\,b\,\epsilon
\f]

Setting \f$ b = 1 \f$ places the derivative \f$ f'(a) \f$ in the dual part
of the result.  Higher derivatives are obtained by nesting:
`dual<dual<T>>` carries both \f$ f' \f$ and \f$ f'' \f$.

\section multivariate Multivariate Differentiation

For functions of multiple variables, `duals/multidual` provides
`dual<T, int N>` — a dual number carrying N independent partial
derivatives.  This computes the full gradient
\f$ \nabla f = (\partial f/\partial x_1, \ldots, \partial f/\partial x_N) \f$
in a single evaluation pass, rather than requiring N separate passes:

```cpp
#include <duals/multidual>

int main() {
  using D3 = duals::dual<double, 3>;
  auto x = D3::variable(1.0, 0);  // seed df/dx
  auto y = D3::variable(2.0, 1);  // seed df/dy
  auto z = D3::variable(3.0, 2);  // seed df/dz

  auto f = sin(x * y) + exp(z);
  // f.dpart(0) = df/dx, f.dpart(1) = df/dy, f.dpart(2) = df/dz
}
```

With `N=1` (the default), `dual<T>` and `dual<T,1>` are identical — all
existing code works unchanged.

\section files Headers

| Header | Purpose |
|--------|---------|
| `duals/dual` | Core `dual<T>` class, math functions, IO, complex overloads |
| `duals/multidual` | Multivariate `dual<T,N>` with compile-time gradient support |
| `duals/dual_eigen` | Eigen NumTraits, type promotion, SIMD packet ops |

 */

// ===================================================================
// partials<T,N> — lightweight wrapper around std::array<T,N> providing
// scalar-array arithmetic for dual<T,N>.  For N=1 it behaves as a
// transparent wrapper around T via implicit conversions.
// ===================================================================

#ifndef CPPDUALS_ASSERT_PARTIAL
#ifdef NDEBUG
#define CPPDUALS_ASSERT_PARTIAL(i) ((void)0)
#else
/// dpart(x) reads partial x -- this catches an integer value left from the
/// one-argument setter that cppduals v0.10.0 renamed to set_dpart().
#define CPPDUALS_ASSERT_PARTIAL(i) assert((i) >= 0 && (i) < N)
#endif
#endif

template<class T, int N> struct partials;

#ifndef PARSED_BY_DOXYGEN
namespace detail {
template<class X> struct is_partials : std::false_type {};
template<class X, int M> struct is_partials<partials<X,M>> : std::true_type {};
}

// A partials scalar operand is anything that multiplies T, but never another
// partials -- those have their own elementwise operators below.
#define CPPDUALS_PARTIALS_SCALAR(U)                                     \
  std::enable_if_t<!detail::is_partials<std::decay_t<U>>::value, int> = 0
#endif

template<class T, int N>
struct partials {
  std::array<T, N> data{};

  constexpr partials() = default;
  constexpr partials(std::array<T, N> a) : data(a) {}

  /// N=1: implicit conversion from a scalar.  U, not T, so that a
  /// dual<dual<T>> can still be built from a T -- going through T here would
  /// need two user-defined conversions and none would be found.
  template<class U, int M = N,
           std::enable_if_t<M == 1 && !detail::is_partials<std::decay_t<U>>::value &&
                            std::is_convertible<U,T>::value, int> = 0>
  constexpr partials(U v) : data{T(v)} {}

  /// N>1: construct from exactly N values.
  // Use std::conjunction_v instead of a fold expression so MSVC's older
  // SFINAE parser (notably MSVC 19.44 in VS 2022) accepts this template.
  template<class... Args,
           std::enable_if_t<(sizeof...(Args) == N) && (N > 1) &&
                            std::conjunction_v<std::is_convertible<Args, T>...>, int> = 0>
  constexpr partials(Args... args) : data{T(args)...} {}

  /// Convert from partials of a different value type, as dual<T> converts
  /// from dual<X>.
  template<class X, std::enable_if_t<!std::is_same<X,T>::value &&
                                     std::is_convertible<X,T>::value, int> = 0>
  constexpr partials(const partials<X,N> & o) {
    for (int i = 0; i < N; i++) data[i] = T(o[i]);
  }

  constexpr T  operator[](int i) const { return data[i]; }
  constexpr T& operator[](int i)       { return data[i]; }

  template<int M = N, std::enable_if_t<M == 1, int> = 0>
  constexpr operator T() const { return data[0]; }

  template<class U, CPPDUALS_PARTIALS_SCALAR(U)>
  constexpr partials operator*(U s) const {
    partials r;
    for (int i = 0; i < N; i++) r.data[i] = T(data[i] * s);
    return r;
  }
  template<class U, CPPDUALS_PARTIALS_SCALAR(U)>
  friend constexpr partials operator*(U s, const partials& p) {
    partials r;
    for (int i = 0; i < N; i++) r.data[i] = T(s * p.data[i]);
    return r;
  }
  template<class U, CPPDUALS_PARTIALS_SCALAR(U)>
  constexpr partials& operator*=(U s) {
    for (int i = 0; i < N; i++) data[i] = T(data[i] * s);
    return *this;
  }

  template<class U, CPPDUALS_PARTIALS_SCALAR(U)>
  constexpr partials operator/(U s) const {
    partials r;
    for (int i = 0; i < N; i++) r.data[i] = T(data[i] / s);
    return r;
  }
  template<class U, CPPDUALS_PARTIALS_SCALAR(U)>
  constexpr partials& operator/=(U s) {
    for (int i = 0; i < N; i++) data[i] = T(data[i] / s);
    return *this;
  }

  constexpr partials operator+(const partials& o) const {
    partials r;
    for (int i = 0; i < N; i++) r.data[i] = data[i] + o.data[i];
    return r;
  }
  constexpr partials operator-(const partials& o) const {
    partials r;
    for (int i = 0; i < N; i++) r.data[i] = data[i] - o.data[i];
    return r;
  }
  constexpr partials operator-() const {
    partials r;
    for (int i = 0; i < N; i++) r.data[i] = -data[i];
    return r;
  }

  constexpr partials& operator+=(const partials& o) {
    for (int i = 0; i < N; i++) data[i] += o.data[i];
    return *this;
  }
  constexpr partials& operator-=(const partials& o) {
    for (int i = 0; i < N; i++) data[i] -= o.data[i];
    return *this;
  }

  template<class U, CPPDUALS_PARTIALS_SCALAR(U)>
  constexpr bool operator==(U s) const {
    for (int i = 0; i < N; i++)
      if (!(data[i] == s)) return false;
    return true;
  }
  template<class U, CPPDUALS_PARTIALS_SCALAR(U)>
  constexpr bool operator!=(U s) const { return !(*this == s); }

  template<class U, int M = N, std::enable_if_t<M == 1, int> = 0,
           CPPDUALS_PARTIALS_SCALAR(U)>
  constexpr bool operator<(U s) const { return data[0] < s; }

  template<class U, int M = N, std::enable_if_t<M == 1, int> = 0,
           CPPDUALS_PARTIALS_SCALAR(U)>
  constexpr bool operator>=(U s) const { return data[0] >= s; }

  static constexpr partials unit(int i) {
    partials r;
    r.data[i] = T(1);
    return r;
  }
};

