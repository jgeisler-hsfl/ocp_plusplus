#define CPPDUALS_LHS_COMPARISON(op) \
  template<class T, class U, int N, CPPDUALS_ENABLE_SAME_DEPTH_AND_COMMON_T(T,U,N,N)> \
  bool \
  operator op(const dual<T,N> & a, const dual<U,N> & b) { \
    return a.rpart() op b.rpart(); \
  } \
  template<class T, int N, class U, CPPDUALS_ENABLE_LEQ_DEPTH_AND_COMMON_T(T,N,U), \
           CPPDUALS_ENABLE_IF(!is_complex<U>::value)> \
  bool \
  operator op(const U & a, const dual<T,N> & b) { \
    return a op b.rpart(); \
  } \
  template<class T, int N, class U, CPPDUALS_ENABLE_LEQ_DEPTH_AND_COMMON_T(T,N,U), \
           CPPDUALS_ENABLE_IF(!is_complex<U>::value)> \
  bool \
  operator op(const dual<T,N> & a, const U & b) { \
    return a.rpart() op b; \
  }

