template<class T, int N> dual<T,N> exp_impl(const dual<T,N> & x) {
  using std::exp;
  T v = exp(x.rpart());
  return dual<T,N>(v, x.dparts() * v);
}

template<class T, int N> dual<T,N> log_impl(const dual<T,N> & x) {
  using std::log;
  T v = log(x.rpart());
  if (x.dparts() == T(0))
    return v;
  else
    return dual<T,N>(v, x.dparts() / x.rpart());
}

template<class T, int N> dual<T,N> log10_impl(const dual<T,N> & x) {
  using std::log;
  return log(x) / log(static_cast<T>(10));
}

template<class T, int N> dual<T,N> log2_impl(const dual<T,N> & x) {
  using std::log;
  return log(x) / log(static_cast<T>(2));
}

template<class T, int N> dual<T,N> logb_impl(const dual<T,N> & x) {
  using std::log; using std::pow; using std::abs; using std::floor;
  T v = floor(log(abs(x.rpart())) / log(std::numeric_limits<T>::radix));
  return dual<T,N>(v,
                   x.rpart() - pow(2,v) ? (T)0 : std::numeric_limits<T>::infinity());
}

// dual<T,N> ^ U
template <typename T, int N, typename U, typename common_t>
common_t pow_dual_scalar(const dual<T,N>& x, const U& y)
{
  using std::pow;
  typedef typename common_t::value_type V;
  typedef partials<V, common_t::num_vars> DP;
  DP dp(x.dparts());
  return common_t(
      pow(x.rpart(), y),
      dp == V(0) ? DP() : dp * (y * pow(x.rpart(), y - U(1))));
}

// U ^ dual<T,N>
template <typename T, int N, typename U, typename common_t>
common_t pow_scalar_dual(const U& x, const dual<T,N>& y)
{
  return pow(common_t(x), y);
}

// complex<dual<T,N>> ^ dual<T,N>
template <typename T, int N>
std::complex<dual<T,N>> pow_complex_dual(const std::complex<dual<T,N>>& x, const dual<T,N>& y)
{
  using dual_t = dual<T,N>;
  dual_t r = sqrt(x.real() * x.real() + x.imag() * x.imag());
  dual_t theta = atan2(x.imag(), x.real());
  dual_t realPart = y * log(r);
  dual_t imagPart = y * theta;
  dual_t exponent = exp(realPart);
  return std::complex<dual_t>(exponent * cos(imagPart), exponent * sin(imagPart));
}

// dual<T,N> ^ complex<dual<T,N>>
template <typename T, int N>
std::complex<dual<T,N>> pow_dual_complex(const dual<T,N>& x, const std::complex<dual<T,N>>& y)
{
  using dual_t = dual<T,N>;
  dual_t ln_x = log(x);
  dual_t realExp = y.real() * ln_x;
  dual_t imagExp = y.imag() * ln_x;
  dual_t magnitude = exp(realExp);
  return std::complex<dual_t>(magnitude * cos(imagExp), magnitude * sin(imagExp));
}

// dual<T,N> ^ dual<U,N>
template <typename T, typename U, int N, typename common_t>
common_t pow_dual_dual(const dual<T,N>& f, const dual<U,N>& g)
{
  using std::log; using std::pow; using std::floor;
  typedef typename common_t::value_type V;
  constexpr int NN = common_t::num_vars;
  common_t result;

  if (f.rpart() == T(0) && g.rpart() >= U(1)) {
    if (g.rpart() > U(1)) {
      result = common_t(0);
    } else {
      result = f;
    }
  }
  else {
    if (f.rpart() < T(0) && g.rpart() == floor(g.rpart())) {
      V const tmp = g.rpart() * pow(f.rpart(), g.rpart() - U(1.0));
      result = common_t(pow(f.rpart(), g.rpart()),
                        f.dparts() == T(0) ? partials<V,NN>() : f.dparts() * tmp);
      if (g.dparts() != U(0.0)) {
        for (int i = 0; i < NN; i++)
          result.set_dpart(std::numeric_limits<T>::quiet_NaN(), i);
      }
    }
    else {
      V const tmp1 = pow(f.rpart(), g.rpart());
      V const tmp2 = g.rpart() * pow(f.rpart(), g.rpart() - T(1.0));
      V const tmp3 = tmp1 * log(f.rpart());
      if (f.dparts() == T(0) && g.dparts() == U(0)) {
        result = common_t(tmp1);
      } else {
        result = common_t(tmp1, f.dparts() * tmp2 + g.dparts() * tmp3);
      }
    }
  }
  return result;
}

template<class T, int N> dual<T,N> sqrt_impl(const dual<T,N> & x) {
  using std::sqrt;
  T v = sqrt(x.rpart());
  if (x.dparts() == T(0))
    return v;
  else
    return dual<T,N>(v, x.dparts() / (T(2) * v));
}

template<class T, int N> dual<T,N> cbrt_impl(const dual<T,N> & x) {
  using std::cbrt;
  T v = cbrt(x.rpart());
  if (x.dparts() == T(0))
    return v;
  else
    return dual<T,N>(v, x.dparts() / (T(3) * v * v));
}

template<class T, int N> dual<T,N> sin_impl(const dual<T,N> & x) {
  using std::sin; using std::cos;
  return dual<T,N>(sin(x.rpart()), x.dparts() * cos(x.rpart()));
}

template<class T, int N> dual<T,N> cos_impl(const dual<T,N> & x) {
  using std::cos; using std::sin;
  return dual<T,N>(cos(x.rpart()), x.dparts() * (-sin(x.rpart())));
}

template<class T, int N> dual<T,N> tan_impl(const dual<T,N> & x) {
  using std::tan;
  T v = tan(x.rpart());
  return dual<T,N>(v, x.dparts() * (v*v + 1));
}

template<class T, int N> dual<T,N> asin_impl(const dual<T,N> & x) {
  using std::asin; using std::sqrt;
  T v = asin(x.rpart());
  if (x.dparts() == T(0))
    return v;
  else
    return dual<T,N>(v, x.dparts() / sqrt(1 - x.rpart()*x.rpart()));
}

template<class T, int N> dual<T,N> acos_impl(const dual<T,N> & x) {
  using std::acos; using std::sqrt;
  T v = acos(x.rpart());
  if (x.dparts() == T(0))
    return v;
  else
    return dual<T,N>(v, x.dparts() * T(-1) / sqrt(1 - x.rpart()*x.rpart()));
}

template<class T, int N> dual<T,N> atan_impl(const dual<T,N> & x) {
  using std::atan;
  T v = atan(x.rpart());
  if (x.dparts() == T(0))
    return v;
  else
    return dual<T,N>(v, x.dparts() / (1 + x.rpart() * x.rpart()));
}

template<class T, int N> dual<T,N> atan2_dual_dual(const dual<T,N> & y, const dual<T,N> & x) {
  using std::atan2;
  T v = atan2(y.rpart(), x.rpart());
  T denom = y.rpart() * y.rpart() + x.rpart() * x.rpart();
  return dual<T,N>(v, (x.rpart() * y.dparts() - y.rpart() * x.dparts()) / denom);
}

template<class T, int N, class U, typename common_t>
common_t atan2_dual_scalar(const dual<T,N> & y, const U & x) {
  using std::atan2;
  T v = atan2(y.rpart(), x);
  return common_t(v, y.dparts() * x / (y.rpart() * y.rpart() + x * x));
}

template<class T, int N, class U, typename common_t>
common_t atan2_scalar_dual(const U & y, const dual<T,N> & x) {
  using std::atan2;
  T v = atan2(y, x.rpart());
  return common_t(v, x.dparts() * T(-1) * y / (y * y + x.rpart() * x.rpart()));
}

template<class T, int N> dual<T,N> hypot_impl(const dual<T,N> & x, const dual<T,N> & y) {
  using std::hypot;
  T h = hypot(x.rpart(), y.rpart());
  return dual<T,N>(h, (x.rpart() * x.dparts() + y.rpart() * y.dparts()) / h);
}

template<class T, int N> dual<T,N> scalbn_impl(const dual<T,N> & arg, int ex) {
  return arg * std::pow((T)2, ex);
}

template<class T, int N> dual<T,N> sinh_impl(const dual<T,N> & x) {
  using std::sinh; using std::cosh;
  return dual<T,N>(sinh(x.rpart()), x.dparts() * cosh(x.rpart()));
}

template<class T, int N> dual<T,N> cosh_impl(const dual<T,N> & x) {
  using std::cosh; using std::sinh;
  return dual<T,N>(cosh(x.rpart()), x.dparts() * sinh(x.rpart()));
}

