template<class T, int N>
inline duals::dual<T,N> abs(const complex<duals::dual<T,N>>& z) {
  return duals::hypot(z.real(), z.imag());
}

template<class T, int N>
inline duals::dual<T,N> arg(const complex<duals::dual<T,N>>& z) {
  return duals::atan2(z.imag(), z.real());
}

template<class T, int N>
inline duals::dual<T,N> norm(const complex<duals::dual<T,N>>& z) {
  return z.real() * z.real() + z.imag() * z.imag();
}

template<class T, int N>
inline complex<duals::dual<T,N>> conj(const complex<duals::dual<T,N>>& z) {
  return complex<duals::dual<T,N>>(z.real(), -z.imag());
}

template<class T, int N>
inline complex<duals::dual<T,N>> polar(const duals::dual<T,N>& rho,
                                       const duals::dual<T,N>& theta = duals::dual<T,N>()) {
  return complex<duals::dual<T,N>>(rho * duals::cos(theta), rho * duals::sin(theta));
}

template<class T, int N>
inline complex<duals::dual<T,N>> exp(const complex<duals::dual<T,N>>& z) {
  duals::dual<T,N> e = duals::exp(z.real());
  return complex<duals::dual<T,N>>(e * duals::cos(z.imag()), e * duals::sin(z.imag()));
}

template<class T, int N>
inline complex<duals::dual<T,N>> log(const complex<duals::dual<T,N>>& z) {
  return complex<duals::dual<T,N>>(duals::log(abs(z)), arg(z));
}

template<class T, int N>
inline complex<duals::dual<T,N>> log10(const complex<duals::dual<T,N>>& z) {
  return log(z) / duals::dual<T,N>(duals::log(duals::dual<T,N>(10)));
}

template<class T, int N>
inline complex<duals::dual<T,N>> sqrt(const complex<duals::dual<T,N>>& z) {
  duals::dual<T,N> r = abs(z);
  duals::dual<T,N> nr = duals::sqrt(r);
  if (nr == duals::dual<T,N>(0))
    return complex<duals::dual<T,N>>();
  duals::dual<T,N> t = arg(z) / duals::dual<T,N>(2);
  return complex<duals::dual<T,N>>(nr * duals::cos(t), nr * duals::sin(t));
}

template<class T, int N>
inline complex<duals::dual<T,N>> pow(const complex<duals::dual<T,N>>& x,
                                     const complex<duals::dual<T,N>>& y) {
  return exp(y * log(x));
}

template<class T, int N>
inline complex<duals::dual<T,N>> sin(const complex<duals::dual<T,N>>& z) {
  return complex<duals::dual<T,N>>(duals::sin(z.real()) * duals::cosh(z.imag()),
                                   duals::cos(z.real()) * duals::sinh(z.imag()));
}

template<class T, int N>
inline complex<duals::dual<T,N>> cos(const complex<duals::dual<T,N>>& z) {
  return complex<duals::dual<T,N>>(duals::cos(z.real()) * duals::cosh(z.imag()),
                                   -duals::sin(z.real()) * duals::sinh(z.imag()));
}

template<class T, int N>
inline complex<duals::dual<T,N>> sinh(const complex<duals::dual<T,N>>& z) {
  return complex<duals::dual<T,N>>(duals::sinh(z.real()) * duals::cos(z.imag()),
                                   duals::cosh(z.real()) * duals::sin(z.imag()));
}

template<class T, int N>
inline complex<duals::dual<T,N>> cosh(const complex<duals::dual<T,N>>& z) {
  return complex<duals::dual<T,N>>(duals::cosh(z.real()) * duals::cos(z.imag()),
                                   duals::sinh(z.real()) * duals::sin(z.imag()));
}

template<class T, int N>
inline complex<duals::dual<T,N>> tan(const complex<duals::dual<T,N>>& z) {
  return sin(z) / cos(z);
}

template<class T, int N>
inline complex<duals::dual<T,N>> tanh(const complex<duals::dual<T,N>>& z) {
  return sinh(z) / cosh(z);
}

