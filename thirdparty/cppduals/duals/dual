// Forward declarations
// ===================================================================

template<class T, int N = 1> class dual;

/// Check if T is dual<>, match non-duals.
template <class T> struct is_dual : std::false_type {};
template <class T, int N> struct is_dual<dual<T,N>> : std::true_type {};

/// Check if T is std::complex<>.
template <class T> struct is_complex : std::false_type {};
template <class T> struct is_complex<std::complex<T>> : std::true_type {};

/// dual_traits — depth tracking and real_type extraction.
template <class T> struct dual_traits {
  enum { depth = 0 };
  typedef T real_type;
};
template <class T, int N> struct dual_traits<dual<T,N>> {
  enum { depth = dual_traits<T>::depth + 1 };
  typedef typename dual_traits<T>::real_type real_type;
};
template <class T, int N> struct dual_traits<std::complex<dual<T,N>>> {
  enum { depth = dual_traits<dual<T,N>>::depth };
  typedef typename dual_traits<T>::real_type real_type;
};

// ===================================================================
// Promotion
// ===================================================================

namespace detail {
template<class T, class U = void>
struct has_member_type : std::false_type {};
template<class T>
struct has_member_type<T, std::void_t<typename T::type>> : std::true_type {
  struct wrap {
    typedef typename T::type type;
    typedef typename T::type ReturnType;
  };
};
} // namespace detail

/// Types opting out of promotion to a dual<>.
template <class X, class V = void> struct never_promote : std::false_type {};

// partials<> is dual<>'s storage, not a number: without this the free
// operators would deduce U = partials<> and tie with partials' own
// elementwise operators.
template <class X, int M> struct never_promote<partials<X,M>> : std::true_type {};

namespace detail {

template <bool Disabled, class T, class U>
struct common_type_unless : std::common_type<T,U> {};
template <class T, class U>
struct common_type_unless<true, T, U> {};

} // namespace detail

template <class T, class U, class V = void>
struct promote
  : detail::common_type_unless<(never_promote<T>::value ||
                                never_promote<U>::value), T, U> {};
template<class A, class B> using can_promote = detail::has_member_type<promote<A,B>>;

// dual<T,N> dual<U,N> — same N required
template <class T, class U, int N>
struct promote<dual<T,N>, dual<U,N>,
               std::enable_if_t<can_promote<T,U>::value &&
                                (int)dual_traits<T>::depth == (int)dual_traits<U>::depth>>
{
  typedef dual<typename promote<U,T>::type, N> type;
};

// dual<T,N> U — T >= U depth, U not complex
template <class T, int N, class U>
struct promote<dual<T,N>, U,
               std::enable_if_t<can_promote<T,U>::value &&
                                (int)dual_traits<T>::depth >= (int)dual_traits<U>::depth &&
                                !is_complex<U>::value>>
{
  typedef dual<typename promote<U,T>::type, N> type;
};

// U dual<T,N>
template <class T, int N, class U>
struct promote<U, dual<T,N>,
               std::enable_if_t<can_promote<T,U>::value &&
                                (int)dual_traits<T>::depth >= (int)dual_traits<U>::depth &&
                                !is_complex<U>::value>>
{
  typedef dual<typename promote<U,T>::type, N> type;
};

// complex<T> complex<U>
template <class T, class U>
struct promote<std::complex<T>, std::complex<U>,
               std::enable_if_t<can_promote<T,U>::value &&
                                (is_dual<T>::value || is_dual<U>::value)>>
{
  typedef std::complex<typename promote<T,U>::type> type;
};

// complex<T> U
template <class T, class U>
struct promote<std::complex<T>, U,
               std::enable_if_t<can_promote<T,U>::value &&
                                (is_dual<T>::value || is_dual<U>::value) &&
                                !is_complex<U>::value>>
{
  typedef std::complex<typename promote<T,U>::type> type;
};

// U complex<T>
template <class T, class U>
struct promote<U, std::complex<T>,
               std::enable_if_t<can_promote<T,U>::value &&
                                (is_dual<T>::value || is_dual<U>::value) &&
                                !is_complex<U>::value>>
{
  typedef std::complex<typename promote<T,U>::type> type;
};

