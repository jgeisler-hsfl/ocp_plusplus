  using std::tanh;
  T v = tanh(x.rpart());
  return dual<T,N>(v, x.dparts() * (1 - v * v));
}

template<class T, int N> dual<T,N> asinh_impl(const dual<T,N> & x) {
  using std::asinh; using std::sqrt;
  return dual<T,N>(asinh(x.rpart()), x.dparts() / sqrt(1 + x.rpart() * x.rpart()));
}

template<class T, int N> dual<T,N> acosh_impl(const dual<T,N> & x) {
  using std::acosh; using std::sqrt;
  return dual<T,N>(acosh(x.rpart()), x.dparts() / sqrt(x.rpart() * x.rpart() - 1));
}

template<class T, int N> dual<T,N> atanh_impl(const dual<T,N> & x) {
  using std::atanh;
  return dual<T,N>(atanh(x.rpart()), x.dparts() / (1 - x.rpart() * x.rpart()));
}

template<class T, int N> dual<T,N> log1p_impl(const dual<T,N> & x) {
  using std::log1p;
  return dual<T,N>(log1p(x.rpart()), x.dparts() / (1 + x.rpart()));
}

template<class T, int N> dual<T,N> expm1_impl(const dual<T,N> & x) {
  using std::expm1; using std::exp;
  return dual<T,N>(expm1(x.rpart()), x.dparts() * exp(x.rpart()));
}

template<class T, int N> dual<T,N> erf_impl(const dual<T,N> & x) {
  using std::erf; using std::sqrt; using std::pow; using std::exp;
  return dual<T,N>(erf(x.rpart()),
                   x.dparts() * (T(2)/sqrt(T(CPPDUALS_MD_PI)) * exp(-pow(x.rpart(),T(2)))));
}

template<class T, int N> dual<T,N> erfc_impl(const dual<T,N> & x) {
  using std::erfc; using std::sqrt; using std::pow; using std::exp;
  return dual<T,N>(erfc(x.rpart()),
                   x.dparts() * (-T(2)/sqrt(T(CPPDUALS_MD_PI)) * exp(-pow(x.rpart(),T(2)))));
}

template<class T, int N> dual<T,N> tgamma_impl(const dual<T,N> & x) {
  using std::tgamma;
  T v = tgamma(x.rpart());
  if (x.dparts() == T(0))
    return v;
  else {
    int errno_saved = errno;
    T h(T(1) / (1ull << (std::numeric_limits<T>::digits / 3)));
    T w((tgamma(x.rpart()+h) - tgamma(x.rpart()-h))/(2*h));
    errno = errno_saved;
    return dual<T,N>(v, x.dparts() * w);
  }
}

template<class T, int N> dual<T,N> lgamma_impl(const dual<T,N> & x) {
  using std::lgamma;
  T v = lgamma(x.rpart());
  if (x.dparts() == T(0))
    return v;
  else {
#if CPPDUALS_HAVE_SIGNGAM
    int signgam_saved = signgam;
#endif
    int errno_saved = errno;
    T h(T(1) / (1ull << (std::numeric_limits<T>::digits / 3)));
    T w((lgamma(x.rpart()+h) - lgamma(x.rpart()-h))/(2*h));
#if CPPDUALS_HAVE_SIGNGAM
    signgam = signgam_saved;
#endif
    errno = errno_saved;
    return dual<T,N>(v, x.dparts() * w);
  }
}

